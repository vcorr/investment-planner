{
  "name": "nordic-paper-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc --noEmit -p web && vite build --config web/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "job:seed-sample": "tsx src/jobs/seed-sample.ts",
    "job:load-verification": "tsx src/jobs/load-verification.ts",
    "job:backfill": "tsx src/jobs/backfill.ts",
    "job:schedule-news-poller": "tsx src/jobs/schedule-news-poller.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
