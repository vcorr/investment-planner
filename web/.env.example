# Copy to web/.env.local and fill in. Both values are public by design (they ship in the page),
# but keep real values out of git anyway. Never put a secret key here.
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
